# Build
build/
build-*/
out/
target/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Data & weights (large binaries; keep dirs via .gitkeep)
data/*
!data/.gitkeep
weights/*
!weights/.gitkeep
*.binpack
match_results*.json
*.jsonl

# Model artifacts
*.pt
*.nnue

# IDE
.vs/
.vscode/
.idea/

# Generated reports and measurement dumps are local artifacts. Specs and
# tickets under .scratch are Markdown and stay tracked.
.scratch/**/*.log
.scratch/**/*.json
