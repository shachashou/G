# Build outputs (build/, Cargo target/, packages)
build/
build-*/
out/
dist/
target/

# The venv-contained build helper scripts live in tools/build and ARE source;
# the "build/" pattern above would otherwise hide them.
!tools/build/
!tools/build/**

# Compiled binaries and intermediates (normal builds land in build/ or target/)
*.exe
*.dll
*.lib
*.pdb
*.obj
*.ilk
.ninja_log
.ninja_deps

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
*.egg-info/
.ipynb_checkpoints/

# Runtime data and weights (generated; keep the directories via .gitkeep)
data/*
!data/.gitkeep
weights/*
!weights/.gitkeep
*.binpack
*.jsonl
match_results*.json
*.log

# Model and tensor artifacts
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.npy
*.npz
*.nnue

# Generated reports and measurement dumps are local artifacts. Specs and
# tickets under .scratch are Markdown and stay tracked.
.scratch/**/*.json

# OS / editor junk
.vs/
# Keep the shared editor configuration, ignore local VSCode state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini
.DS_Store
*.swp
*.tmp
*.orig
*.rej

# Installed skills: content is fetched from the sources pinned in
# skills-lock.json, so it is installed material, not project source.
.agents/skills/

# Local Rapfi teacher install (binaries + Renju weights; identity pinned in
# tools/rapfi.lock.json)
tools/rapfi/

